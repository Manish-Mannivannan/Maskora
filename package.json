{
  "name": "maskora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "setup": "npm ci && node scripts/setup.mjs",
    "predev": "node scripts/copy-pdfjs.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/copy-pdfjs.mjs",
    "build": "next build",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "probe:pdf": "node scripts/probe-pdf.mjs",
    "probe:relief": "node scripts/probe-relief.mjs",
    "check:conventions": "node scripts/check-secrets.mjs && node scripts/check-adr-references.mjs && node scripts/check-versions.mjs && node tests/fixtures/generate.mjs --check",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run check:conventions && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run check:rust",
    "plan:issues": "node scripts/sync-plan-issues.mjs",
    "graphify:vault": "node scripts/prefix-graphify-vault.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tauri-apps/api": "2.12.4",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
