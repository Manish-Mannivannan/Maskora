{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maskora",
  "version": "0.1.0",
  "identifier": "com.manis.maskora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maskora",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:3000",
        "script-src": "'self' 'unsafe-eval' 'unsafe-inline' 'wasm-unsafe-eval' http://localhost:3000",
        "style-src": "'self' 'unsafe-inline' http://localhost:3000",
        "img-src": "'self' blob: data: http://localhost:3000",
        "font-src": "'self' data: http://localhost:3000",
        "worker-src": "'self' blob: http://localhost:3000",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3000 ws://localhost:3000",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
